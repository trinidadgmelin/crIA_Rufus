MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 892518703}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 926443754f978384c82eb656ff88cef8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  popUp: {fileID: 944999585}
  textoUnico: {fileID: 114172429}
  imagenUnica: {fileID: 1580828284}
  guiaAvanzar: {fileID: 0}
  pasosDeEsteHitbox:
  - textoPaso: "Antes, las acciones activaban animaciones predeterminadas, sin considerar
      el contexto emocional o f\xEDsico del personaje. Actualmente, la IA combina
      animaciones mediante una matriz psicol\xF3gica y t\xE9cnicas procedurales,
      adaptando sus movimientos al entorno y su estado. Un ejemplo es Trico, de The
      Last Guardian, que utiliza Inverse Kinematics para adaptar sus movimientos
      al terreno."
    imagenPaso: {fileID: 21300000, guid: 8380a4c1afe946748bc1b9d1b58b1efa, type: 3}
  fondoNido: {fileID: 736078193}
  fondoHover: {fileID: 21300000, guid: 831e06e646e473745a815dcd6b73a2fb, type: 3}
